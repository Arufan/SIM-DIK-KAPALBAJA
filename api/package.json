{
  "name": "simdik-api",
  "version": "0.1.0",
  "description": "SIM-DIK KAPALBAJA backend: auth, CRUD, offline sync",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "seed": "node --env-file=.env prisma/seed.js",
    "smoke": "node --env-file=.env scripts/smoke-sync.mjs",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.16.0"
  }
}
