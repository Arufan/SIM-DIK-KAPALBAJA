# SQLite file (relative to prisma/schema.prisma). In Docker use file:/data/simdik.db
DATABASE_URL="file:./data/simdik.db"

# Generate real secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="60d"

# Used by prisma/seed.js on first run only
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme123"

PORT=8080
